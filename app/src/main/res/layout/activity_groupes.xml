<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Header Bar -->
    <RelativeLayout
        android:id="@+id/headerGroupes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E3A5F"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/txtTitreGroupes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liste des Groupes"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/txtSousTitreGroupes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtTitreGroupes"
            android:layout_marginTop="4dp"
            android:text="Gestion et effectif des stagiaires"
            android:textSize="14sp"
            android:textColor="#CBD5E1"/>

    </RelativeLayout>

    <!-- Buttons Bar: ArrayAdapter (Blue) & BaseAdapter (Green) -->
    <LinearLayout
        android:id="@+id/layoutAdapterButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnArrayAdapter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="ArrayAdapter"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB" />

        <Button
            android:id="@+id/btnBaseAdapter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="BaseAdapter"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#16A34A" />

    </LinearLayout>

    <!-- ListView for Groups -->
    <ListView
        android:id="@+id/listGroupes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:divider="@null"
        android:clipToPadding="false"/>

</LinearLayout>
